{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "A document submission for cash advance or reimbursement.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["uang_muka", "reimburse", "laporan_uang_muka", "pembiayaan"] },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "currentStageIndex": { "type": "number" },
        "picName": { "type": "string" },
        "namaBank": { "type": "string" },
        "sumberRekening": { "type": "string", "enum": ["SMP", "SMA", "Donasi SMP", "Donasi SMA"] },
        "kodeBudget": { "type": "string" },
        "noDokumen": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submittedByName": { "type": "string" },
        "submittedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "evidenceUrl": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "status": { "type": "string" },
              "actor": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "comment": { "type": "string" }
            }
          }
        }
      },
      "required": ["type", "title", "amount", "status", "currentStageIndex", "submittedBy", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Application user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["staff", "finance", "accountant", "management", "admin"] },
        "allowedMenus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Application configuration settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "logoURL": { "type": "string" }
      },
      "required": ["id"]
    },
    "BerkasDigital": {
      "title": "BerkasDigital",
      "description": "Google Drive links for digital files organized by month and year.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tahun": { "type": "string" },
        "bulan": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tahun", "bulan", "link", "createdAt"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Donation confirmation records.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "donaturName": { "type": "string" },
        "contact": { "type": "string" },
        "amount": { "type": "number" },
        "targetAccount": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "donaturName",
        "contact",
        "amount",
        "targetAccount",
        "status",
        "createdAt"
      ]
    },
    "DashboardGallery": {
      "title": "DashboardGallery",
      "description": "Media items (photos/videos) for the dashboard gallery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "url", "createdAt"]
    },
    "DocumentTemplate": {
      "title": "DocumentTemplate",
      "description": "Custom document template uploaded by owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "fileName", "content", "createdAt"]
    },
    "LaporanBaznasCustomValue": {
      "title": "LaporanBaznasCustomValue",
      "description": "Custom budget and actual overrides for BAZNAS report items.",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "year": { "type": "string" },
        "account": { "type": "string", "enum": ["SMP", "SMA"] },
        "code": { "type": "string" },
        "budget": { "type": "number" },
        "real": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userUid": { "type": "string" }
      },
      "required": ["month", "year", "code", "budget", "real", "userUid"]
    },
    "LaporanBaznasRincian": {
      "title": "LaporanBaznasRincian",
      "description": "Detailed transactions representing BAZNAS report use cases.",
      "type": "object",
      "properties": {
        "account": { "type": "string", "enum": ["SMP", "SMA"] },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "kodeBudget": { "type": "string" },
        "noDoc": { "type": "number" },
        "noBukti": { "type": "string" },
        "tanggalBudget": { "type": "string" },
        "keterangan": { "type": "string" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "noBuktiDetail": { "type": "string" },
              "tanggalDetail": { "type": "string" },
              "keteranganDetail": { "type": "string" },
              "qty": { "type": "number" },
              "hargaSatuan": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userUid": { "type": "string" }
      },
      "required": ["account", "month", "year", "kodeBudget", "noDoc", "noBukti", "tanggalBudget", "keterangan", "details", "userUid"]
    },
    "LaporanBaznasSettlement": {
      "title": "LaporanBaznasSettlement",
      "description": "Settlement documents and details for BAZNAS budget settlement.",
      "type": "object",
      "properties": {
        "account": { "type": "string", "enum": ["SMP", "SMA"] },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "kodeBudget": { "type": "string" },
        "namaAnggaran": { "type": "string" },
        "paguAnggaran": { "type": "number" },
        "noDoc": { "type": "number" },
        "noBukti": { "type": "string" },
        "tanggalBudget": { "type": "string" },
        "keterangan": { "type": "string" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "noBuktiDetail": { "type": "string" },
              "tanggalDetail": { "type": "string" },
              "keteranganDetail": { "type": "string" },
              "qty": { "type": "number" },
              "hargaSatuan": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userUid": { "type": "string" }
      },
      "required": ["account", "month", "year", "kodeBudget", "noDoc", "noBukti", "tanggalBudget", "keterangan", "details", "userUid"]
    },
    "RealisasiBulanan": {
      "title": "RealisasiBulanan",
      "description": "Monthly realization inputs for programs, salaries, and food.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tahun": { "type": "string" },
        "bulan": { "type": "string" },
        "program": { "type": "number" },
        "gaji": { "type": "number" },
        "makan": { "type": "number" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tahun", "bulan", "program", "gaji", "makan", "createdAt"]
    },
    "DonationCashflowTransaction": {
      "title": "DonationCashflowTransaction",
      "description": "Donation reception and expenditure cashflow transaction details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "account": { "type": "string", "enum": ["smp", "sma"] },
        "type": { "type": "string", "enum": ["penerimaan", "pengeluaran"] },
        "category": { "type": "string", "enum": ["dana_terikat", "dana_tidak_terikat", "non_program", "program"] },
        "subCategory": { "type": "string" },
        "budgetName": { "type": "string" },
        "amount": { "type": "number" },
        "year": { "type": "number" },
        "dateStr": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["account", "type", "category", "budgetName", "amount", "year", "dateStr", "createdAt"]
    },
    "DonationBudgetCategory": {
      "title": "DonationBudgetCategory",
      "description": "Custom or default budget names/categories for donations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "account": { "type": "string", "enum": ["smp", "sma"] },
        "type": { "type": "string", "enum": ["penerimaan", "pengeluaran"] },
        "category": { "type": "string", "enum": ["dana_terikat", "dana_tidak_terikat", "non_program", "program"] },
        "subCategory": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["account", "type", "category", "name", "createdAt"]
    },
    "DonationSaldoAwal": {
      "title": "DonationSaldoAwal",
      "description": "Starting balance configuration for donation reports by year and account.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "account": { "type": "string", "enum": ["smp", "sma"] },
        "year": { "type": "number" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["account", "year", "amount", "createdAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Collection of document submissions."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/config/{configId}": {
      "schema": "AppConfig",
      "description": "Application configuration settings."
    },
    "/berkas_digital/{berkasId}": {
      "schema": "BerkasDigital",
      "description": "Collection of digital file links."
    },
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Collection of donation confirmations."
    },
    "/dashboard_gallery/{galleryId}": {
      "schema": "DashboardGallery",
      "description": "Collection of media for the dashboard."
    },
    "/document_templates/{templateId}": {
      "schema": "DocumentTemplate",
      "description": "Collection of document templates."
    },
    "/laporan_baznas_custom_values/{valueId}": {
      "schema": "LaporanBaznasCustomValue",
      "description": "Collection of custom budget/actual overrides for BAZNAS items."
    },
    "/laporan_baznas_rincian_docs/{rincianId}": {
      "schema": "LaporanBaznasRincian",
      "description": "Collection of detailed transactional structures for BAZNAS report."
    },
    "/laporan_baznas_settlement_docs/{settlementId}": {
      "schema": "LaporanBaznasSettlement",
      "description": "Collection of settlement documents and details for BAZNAS budget settlement."
    },
    "/realisasi_bulanan/{realisasiId}": {
      "schema": "RealisasiBulanan",
      "description": "Collection of monthly realization records."
    },
    "/donation_cashflow_transactions/{transactionId}": {
      "schema": "DonationCashflowTransaction",
      "description": "Donation cashflow transactions representing income and expense."
    },
    "/donation_budget_categories/{categoryId}": {
      "schema": "DonationBudgetCategory",
      "description": "Donation budget names/categories."
    },
    "/donation_saldo_awal/{saldoId}": {
      "schema": "DonationSaldoAwal",
      "description": "Yearly starting balance configurations for SMP/SMA donations."
    }
  }
}
