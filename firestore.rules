rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based access from 'users' collection
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      let isHardcodedAdmin = isSignedIn() && (
        (request.auth.token.email == "keuanganscbbaznas@gmail.com" || 
         request.auth.token.email == "keuangan.scb@gmail.com" ||
         request.auth.token.email == "kamal2015go@gmail.com" ||
         request.auth.token.email == "operasional.scb@gmail.com") && 
        request.auth.token.email_verified == true
      );
      
      let hasAdminRole = isSignedIn() && 
                         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      return isHardcodedAdmin || hasAdminRole;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['staff', 'finance', 'accountant', 'management', 'admin'] &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('allowedMenus' in data) || data.allowedMenus is list);
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['type', 'title', 'amount', 'status', 'currentStageIndex', 'submittedBy', 'createdAt', 'updatedAt']);
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['donaturName', 'contact', 'amount', 'targetAccount', 'status', 'createdAt']) &&
             data.donaturName is string && data.donaturName.size() <= 256 &&
             data.contact is string && data.contact.size() <= 256 &&
             data.amount is number &&
             data.targetAccount is string &&
             data.status in ['pending', 'verified', 'rejected'] &&
             data.createdAt is timestamp;
    }

    function isValidAppConfig(data) {
      return (!('logoURL' in data) || data.logoURL is string);
    }

    function isValidGallery(data) {
      return data.keys().hasAll(['type', 'url', 'createdAt']) &&
             data.type in ['image', 'video'] &&
             data.url is string &&
             data.createdAt == request.time &&
             (!('title' in data) || data.title is string) &&
             (!('description' in data) || data.description is string);
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'category', 'fileName', 'content', 'createdAt']) &&
             data.name is string && data.name.size() <= 256 &&
             data.category is string && data.category.size() <= 128 &&
             data.fileName is string && data.fileName.size() <= 256 &&
             data.content is string && data.content.size() <= 2000000 &&
             data.createdAt is string &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1024)) &&
             (!('fileType' in data) || (data.fileType is string && data.fileType.size() <= 128));
    }

    function isOnlyOwner() {
      return isSignedIn() && 
             (request.auth.token.email.lower() == "keuanganscbbaznas@gmail.com" || 
              request.auth.token.email.lower() == "keuangan.scb@gmail.com");
    }

    function isTrueOwner() {
      return isSignedIn() && 
             request.auth.token.email.lower() == "keuanganscbbaznas@gmail.com";
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && 
                      (incoming().role == 'staff' || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) &&
                      (incoming().role == existing().role || isAdmin());
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidSubmission(incoming()) && 
                      incoming().submittedBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(submissionId) && (
        // Admin can update everything if payload is valid
        (isAdmin() && isValidSubmission(incoming())) ||
        // Staff/Approvers can update if stages are followed and payload is valid
        (isValidSubmission(incoming()) && (
          isOwner(existing().submittedBy) || 
          getRole() in ['finance', 'accountant', 'management']
        ))
      );
      allow delete: if isAdmin();
    }
    
    match /config/{configId} {
        allow read: if true;
        allow write: if isAdmin() && isValidAppConfig(incoming());
    }

    match /baznas_budgets/{budgetId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && incoming().submittedBy == request.auth.uid;
      allow update: if isSignedIn() && request.auth.token.email_verified == true && (isOwner(existing().submittedBy) || isAdmin());
      allow delete: if isSignedIn() && request.auth.token.email_verified == true && (isOwner(existing().submittedBy) || isAdmin());
    }

    match /laporan_baznas/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.token.email_verified == true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /berkas_digital/{berkasId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /donations/{donationId} {
      allow read: if isAdmin() || getRole() in ['finance', 'accountant', 'management'];
      allow create: if isValidDonation(incoming()) && incoming().createdAt == request.time;
      allow update: if (isAdmin() || getRole() in ['finance', 'accountant', 'management']) && 
                       isValidDonation(incoming()) && 
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    match /dashboard_gallery/{galleryId} {
      allow read: if true;
      allow create: if isOnlyOwner() && isValidGallery(incoming());
      allow update: if isOnlyOwner() && isValidGallery(incoming());
      allow delete: if isOnlyOwner();
    }

    match /document_templates/{templateId} {
      allow read: if true;
      allow create: if isTrueOwner() && isValidTemplate(incoming());
      allow update: if isTrueOwner() && isValidTemplate(incoming());
      allow delete: if isTrueOwner();
    }
  }
}
